pt:{logout:"Sair",app_title:"Formulário de Candidatura",personal:"Detalhes Pessoais",full_name:"Nome Completo *",dob:"Data de Nascimento *",id_num:"Número de ID *",gender:"Género *",birth_town:"Cidade Natal *",nickname:"Apelido",country:"País *",phone:"Número de Telefone *",business:"Informação Comercial",business_type:"Tipo de Negócio *",business_loc:"Localização do Negócio *",lodge:"Preferência de Lodge",nearest:"Lodge Mais Próximo *",submit:"Enviar Candidatura",update:"Atualizar Candidatura"},
fr:{logout:"Déconnexion",app_title:"Formulaire de Candidature",personal:"Détails Personnels",full_name:"Nom Complet *",dob:"Date de Naissance *",id_num:"Numéro ID *",gender:"Genre *",birth_town:"Ville Natale *",nickname:"Surnom",country:"Pays *",phone:"Numéro Téléphone *",business:"Info Entreprise",business_type:"Type d'Entreprise *",business_loc:"Emplacement Entreprise *",lodge:"Préférence Loge",nearest:"Loge la Plus Proche *",submit:"Soumettre Candidature",update:"Mettre à Jour"},
zu:{logout:"Phuma",app_title:"Ifomu Lesicelo Sobulungu",personal:"Imininingwane Yakho",full_name:"Igama Eligcwele *",dob:"Usuku Lokuzalwa *",id_num:"Inombolo Kamazisi *",gender:"Ubulili *",birth_town:"Idolobha Lokuzalwa *",nickname:"Isiteketiso",country:"Izwe *",phone:"Inombolo Yocingo *",business:"Ulwazi Lwebhizinisi",business_type:"Uhlobo Lwebhizinisi *",business_loc:"Indawo Yebhizinisi *",lodge:"Okuthandayo Lodge",nearest:"Lodge Esondele *",submit:"Thumela Isicelo",update:"Buyekeza Isicelo"},
ha:{logout:"Fita",app_title:"Fom ɗin Memba",personal:"Bayanan Kai",full_name:"Cikakken Suna *",dob:"Ranar Haihuwa *",id_num:"Lambar ID *",gender:"Jinsi *",birth_town:"Garin Haihuwa *",nickname:"Lakabi",country:"Ƙasa *",phone:"Lambar Waya *",business:"Bayanin Kasuwanci",business_type:"Nau'in Kasuwanci *",business_loc:"Wurin Kasuwanci *",lodge:"Zaɓin Lodge",nearest:"Lodge Mafi Kusa *",submit:"Aika Aikace",update:"Sabunta Aikace"},
tw:{logout:"Fi mu",app_title:"Agbatɔfoɔ Abisadeɛ Fɔm",personal:"Wo Ho Nsɛm",full_name:"Din Paa *",dob:"Awoda *",id_num:"ID Nɔma *",gender:"Bɔbeasu *",birth_town:"Kuromu Bawoe *",nickname:"Abusudin",country:"Ɔman *",phone:"Telefon Nɔma *",business:"Adwadie Ho Nsɛm",business_type:"Adwadie Ko *",business_loc:"Adwadie Beae *",lodge:"Lodge Pɛ",nearest:"Lodge a Ɛbɛn *",submit:"Fa Abisadeɛ Kɔ",update:"Yɛ Abisadeɛ Foforo"},
am:{logout:"ውጣ",app_title:"የአባልነት ማመልከቻ ቅጽ",personal:"የግል ዝርዝሮች",full_name:"ሙሉ ስም *",dob:"የትውልድ ቀን *",id_num:"መታወቂያ ቁጥር *",gender:"ጾታ *",birth_town:"የትውልድ ከተማ *",nickname:"ቅጽል ስም",country:"ሀገር *",phone:"ስልክ ቁጥር *",business:"የንግድ መረጃ",business_type:"የንግድ አይነት *",business_loc:"የንግድ ቦታ *",lodge:"የሎጅ ምርጫ",nearest:"ቅርብ ሎጅ *",submit:"ማመልከቻ አስገባ",update:"ማመልከቻ አዘምን"},
sn:{logout:"Buda",app_title:"Fomu Yekunyorera Nhengo",personal:"Ruzivo Rwako",full_name:"Zita Rizere *",dob:"Zuva rekuzvarwa *",id_num:"Nhamba yeID *",gender:"Murume/Mukadzi *",birth_town:"Guta Rekuzvarwa *",nickname:"Zita remadunhurirwa",country:"Nyika *",phone:"Nhamba dzeNhare *",business:"Ruzivo rweBhizinesi",business_type:"Mhando yeBhizinesi *",business_loc:"Nzvimbo yeBhizinesi *",lodge:"Lodge Yaunoda",nearest:"Lodge Iri Pedyo *",submit:"Tumira Chikumbiro",update:"Gadzirisa Chikumbiro"},
bem:{logout:"Fuma",app_title:"Fomu ya Kupempula Ub member",personal:"Ifikwata Kuli Imwe",full_name:"Ishina Lyonse *",dob:"Ubusuku bwa Kufyalwa *",id_num:"Namba ya ID *",gender:"Umwaume/Umukashi *",birth_town:"Musumba wa Kufyalwa *",nickname:"Ishina lyakuseka",country:"Caro *",phone:"Namba ya Lamba *",business:"Ulubuto lwa Bizinensi",business_type:"Mutundu wa Bizinensi *",business_loc:"Bizinensi Ili Kwi? *",lodge:"Lodge Mupanga",nearest:"Lodge Ipepi *",submit:"Tumeni Ukupempula",update:"Cinjenipo Ukupempula"},
tn:{logout:"Tswa",app_title:"Foromo ya Kopo ya Botho",personal:"Dintlha tsa Gago",full_name:"Leina le le Feletseng *",dob:"Letsatsi la Matsalo *",id_num:"Nomore ya ID *",gender:"Bong *",birth_town:"Toropo ya Matsalo *",nickname:"Leina la Tshameko",country:"Naga *",phone:"Nomore ya Mogala *",business:"Tshedimosetso ya Kgwebo",business_type:"Mofuta wa Kgwebo *",business_loc:"Lefelo la Kgwebo *",lodge:"Kgetho ya Lodge",nearest:"Lodge e e Gaufi *",submit:"Romela Kopo",update:"Tshwaraganya Kopo"},
ng:{logout:"Zapo",app_title:"Oformu ya Epulo lyOohambe",personal:"Iiyemo Yoye",full_name:"Edhina Alihe *",dob:"Esiku Lyokuningwa *",id_num:"Onomola yO ID *",gender:"Oshinima *",birth_town:"Oshitopolwa Shokuningwa *",nickname:"Edhina Lyokutseya",country:"Oshilongo *",phone:"Onomola yOngodi *",business:"Ouyele wOshitopolwa",business_type:"Oshigwana shOshitopolwa *",business_loc:"Ehala Lyoshitopolwa *",lodge:"Oshipopiwa shO lodge",nearest:"Olodge Lili Popepi *",submit:"Tuma Epulo",update:"Longekidha Epulo"},
hi:{logout:"लॉगआउट",app_title:"सदस्यता आवेदन पत्र",personal:"व्यक्तिगत विवरण",full_name:"पूरा नाम *",dob:"जन्म तिथि *",id_num:"आईडी नंबर *",gender:"लिंग *",birth_town:"जन्म शहर *",nickname:"उपनाम",country:"देश *",phone:"फोन नंबर *",business:"व्यापार जानकारी",business_type:"व्यापार का प्रकार *",business_loc:"व्यापार स्थान *",lodge:"लॉज वरीयता",nearest:"निकटतम लॉज *",submit:"आवेदन जमा करें",update:"आवेदन अपडेट करें"}
};
function getLang(){return localStorage.getItem('siteLang')||'en';}
function tr(k){const lang=getLang();return (T[lang]&&T[lang][k])||T.en[k]||k;}
function applyLang(){
 const lang=getLang();const dict=T[lang]||T.en;
 document.querySelectorAll('[data-i18n]').forEach(el=>{const key=el.dataset.i18n;if(dict[key]) el.textContent=dict[key];});
 const btn=document.getElementById('submitBtn');
 if(btn){btn.textContent=btn.textContent.includes('Update')||btn.textContent.includes('Sasisha')||btn.textContent.includes('Kyusa')?tr('update'):tr('submit');}
}
applyLang();
document.addEventListener('DOMContentLoaded',applyLang);
</script>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getAuth, signOut, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
import { getDatabase, ref, set, get, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js";
const firebaseConfig = {apiKey:"AIzaSyBSs3ekiR8vQ_1Ar5oZVBKGjuOQbwcgNEM",authDomain:"mansonry-family-fraternity.firebaseapp.com",databaseURL:"https://mansonry-family-fraternity-default-rtdb.europe-west1.firebasedatabase.app",projectId:"mansonry-family-fraternity",storageBucket:"mansonry-family-fraternity.firebasestorage.app",messagingSenderId:"964415179161",appId:"1:964415179161:web:c8fd1a777542932d7c6b08"};
const app = initializeApp(firebaseConfig);const auth = getAuth(app);const database = getDatabase(app);
let currentUser = null;let isEditMode = false;let existingStatus = "pending";
const form = document.getElementById("applicationForm");
const submitBtn = document.getElementById("submitBtn");
const countrySelect = document.getElementById("country");
const countryCodeSelect = document.getElementById("countryCode");
const toast = document.getElementById("toast");
const toastIcon = document.getElementById("toastIcon");
const toastMessage = document.getElementById("toastMessage");
const countryToCode = {"Kenya":"+254","Uganda":"+256","Tanzania":"+255","Rwanda":"+250","Guinea-Bissau":"+245","DRC":"+243","South Africa":"+27","Nigeria":"+234","Ghana":"+233","Ethiopia":"+251","Zimbabwe":"+263","Zambia":"+260","Botswana":"+267","Namibia":"+264","USA":"+1","Canada":"+1","UK":"+44","Australia":"+61","India":"+91"};
countrySelect.addEventListener("change", () => { if(countryToCode[countrySelect.value]){ countryCodeSelect.value = countryToCode[countrySelect.value]; }});
function showToast(type, message){toast.className = `toast ${type} show`;toastIcon.textContent = type === 'success'? '✓' : '✕';toastMessage.textContent = message;setTimeout(() => {toast.classList.remove('show');}, 3000);}
function fillForm(data){
  document.getElementById('fullName').value = data.fullName || '';
  document.getElementById('dob').value = data.dob || '';
  document.getElementById('idNumber').value = data.idNumber || '';
  document.getElementById('gender').value = data.gender || '';
  document.getElementById('birthTown').value = data.birthTown || '';
  document.getElementById('nickname').value = data.nickname || '';
  document.getElementById('businessType').value = data.businessType || '';
  document.getElementById('businessLocation').value = data.businessLocation || '';
  document.getElementById('nearestLodge').value = data.nearestLodge || '';
  document.getElementById('country').value = data.country || '';
  document.getElementById('countryCode').value = data.countryCode || '';
  document.getElementById('phone').value = data.phoneNumber || '';
  existingStatus = data.status || "pending";
  isEditMode = true;
  submitBtn.textContent = tr('update');
  form.classList.add('submitted');
}
onAuthStateChanged(auth, async (user) => {
  if (user) {
    currentUser = user;
    const snapshot = await get(ref(database, "applications/" + user.uid));
    if(snapshot.exists()){ fillForm(snapshot.val()); }
  } else { window.location.href = "login.html"; }
});
form.addEventListener("submit", async (e) => {
  e.preventDefault();
  if(!currentUser) return showToast('error','Please login first');
  submitBtn.disabled = true;
  submitBtn.textContent = isEditMode? "Updating..." : "Submitting...";
  const country = document.getElementById('country').value;
  const countryCode = document.getElementById('countryCode').value;
  const phoneNumber = document.getElementById('phone').value.trim();
  const applicationData = {
    fullName: document.getElementById('fullName').value.trim(),
    dob: document.getElementById('dob').value,
    idNumber: document.getElementById('idNumber').value.trim(),
    gender: document.getElementById('gender').value,
    birthTown: document.getElementById('birthTown').value.trim(),
    nickname: document.getElementById('nickname').value.trim(),
    country, countryCode, phoneNumber, phone: countryCode + phoneNumber,
    businessType: document.getElementById('businessType').value.trim(),
    businessLocation: document.getElementById('businessLocation').value.trim(),
    nearestLodge: document.getElementById('nearestLodge').value.trim(),
    status: existingStatus, submittedBy: currentUser.uid, updatedAt: serverTimestamp()
  };
  try{
    await set(ref(database, "applications/" + currentUser.uid), applicationData);
    showToast('success', isEditMode? 'Application Updated!' : 'Application Submitted!');
    form.classList.add('submitted');
    setTimeout(() => {window.location.href = "help.html";}, 1500);
  } catch(error){
    showToast('error','Save Failed: ' + error.message);
    submitBtn.disabled = false;
  }
});
document.querySelector(".logout").addEventListener("click",(e)=>{e.preventDefault();signOut(auth).then(()=>{window.location.href="login.html";});});
</script>
</body>
</html>
