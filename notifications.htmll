<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Notifications | Freemasonry Heritage</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root{--gold:#d4af37;--gold-dark:#b8941f;--dark:#07111f;--card:#121D33;--border:#1E2E4F;}
*{margin:0;padding:0;box-sizing:border-box;font-family:'Poppins',sans-serif;}
body{background:var(--dark);color:white;min-height:100vh;padding-bottom:120px;}
body::before{content:"";position:fixed;top:0;left:0;width:100%;height:100%;background:linear-gradient(rgba(7,17,31,.88), rgba(7,17,31,.95)),url("1517026394531.jpeg");background-size:cover;background-position:center;background-attachment:fixed;z-index:-2;}
header{position:fixed;top:0;left:0;width:100%;padding:20px 8%;background:rgba(0,0,0,.8);backdrop-filter:blur(15px);display:flex;justify-content:space-between;align-items:center;z-index:1000;border-bottom:1px solid rgba(212,175,55,.2);}
.logo{font-size:28px;font-weight:700;color:var(--gold);font-family:'Playfair Display',serif;}
.logout{background:var(--gold);color:#111;padding:10px 25px;border-radius:30px;text-decoration:none;font-weight:600;}
.container{padding:130px 8% 50px;max-width:900px;margin:auto;}
.page-title{text-align:center;margin-bottom:30px;}
.page-title h1{font-size:36px;color:var(--gold);font-family:'Playfair Display',serif;}
.notif-card{background:linear-gradient(145deg,rgba(20,34,56,.9),rgba(11,23,40,.9));border:1px solid rgba(212,175,55,.25);border-radius:18px;padding:18px 20px;margin-bottom:14px;display:flex;gap:14px;align-items:flex-start;transition:.3s;position:relative;}
.notif-card.unread{border:1px solid #00ff88;background:linear-gradient(145deg,rgba(15,42,31,.8),rgba(20,34,56,.9));}
.notif-icon{width:44px;height:44px;border-radius:50%;background:var(--gold);display:grid;place-items:center;color:#000;flex-shrink:0;font-size:18px;}
.notif-content{flex:1;}
.notif-content b{color:var(--gold);font-size:14px;}
.notif-content p{color:#ddd;font-size:13px;margin:6px 0;line-height:1.5;word-break:break-word;}
.notif-time{color:#888;font-size:11px;}
.notif-actions{display:flex;gap:8px;margin-top:10px;}
.action-btn{padding:6px 12px;border-radius:20px;border:1px solid rgba(212,175,55,.3);background:rgba(0,0,0,.3);color:#ccc;font-size:11px;cursor:pointer;display:inline-flex;align-items:center;gap:5px;}
.action-btn.delete{border-color:rgba(255,77,77,.3);color:#ff8a8a;}
.action-btn:hover{color:var(--gold);border-color:var(--gold);}
.bottom-nav{position:fixed;bottom:25px;left:50%;transform:translateX(-50%);background:rgba(15,26,46,.94);backdrop-filter:blur(25px);padding:10px;border-radius:22px;display:flex;gap:8px;border:1px solid rgba(212,175,55,.25);z-index:2000;max-width:calc(100% - 30px);}
.nav-item{width:90px;height:70px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-decoration:none;color:#a0b0c9;border-radius:16px;font-size:11px;font-weight:500;}
.nav-item.active{background:linear-gradient(135deg,#d4af37,#b8941f);color:#111;font-weight:600;}
.nav-icon{width:24px;height:24px;margin-bottom:5px;fill:currentColor;}
#empty{padding:80px 20px;text-align:center;color:#888;}
.toast{position:fixed;bottom:110px;left:50%;transform:translateX(-50%) translateY(20px);background:linear-gradient(135deg,var(--gold),var(--gold-dark));color:#000;padding:12px 24px;border-radius:30px;font-size:13px;font-weight:700;z-index:9999;opacity:0;transition:.3s;pointer-events:none;box-shadow:0 10px 30px rgba(212,175,55,.4);}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0);}
</style>
</head><body>
<header>
<div class="logo">Freemasonry Heritage</div>
<div style="display:flex;gap:18px;align-items:center;">
<a href="globaladmin.html" style="position:relative;color:#d4af37;font-size:22px;text-decoration:none;"><i class="fa fa-comments"></i><span id="globalChatBadge" style="position:absolute;top:-8px;right:-8px;background:#00ff88;color:#000;font-size:10px;min-width:18px;height:18px;border-radius:50%;display:none;place-items:center;padding:0 4px;font-weight:800;">0</span></a>
<a href="notifications.html" style="position:relative;color:#d4af37;font-size:22px;text-decoration:none;"><i class="fa fa-bell"></i><span id="notifBadge" style="position:absolute;top:-8px;right:-8px;background:#dc2743;color:white;font-size:10px;min-width:18px;height:18px;border-radius:50%;display:none;place-items:center;padding:0 4px;font-weight:700;">0</span></a>
<a href="#" class="logout" id="logoutBtn" data-i18n="logout">Logout</a>
</div>
</header>

<main class="container">
<div class="page-title"><h1><i class="fa fa-bell"></i> <span data-i18n="notif_title">Notifications</span></h1><p style="color:#aaa;font-size:13px;margin-top:8px;" data-i18n="notif_sub">All updates from Lodge Director</p></div>
<div id="notifList"><div id="empty"><span data-i18n="loading">Loading notifications...</span><br><i class="fa fa-spinner fa-spin" style="margin-top:10px;"></i></div></div>
</main>

<div id="toast" class="toast"></div>

<nav class="bottom-nav">
<a href="dashboard.html" class="nav-item"><svg class="nav-icon" viewBox="0 0 24 24"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg><span data-i18n="home">Home</span></a>
<a href="requirements.html" class="nav-item"><svg class="nav-icon" viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg><span data-i18n="req">Requirements</span></a>
<a href="application.html" class="nav-item"><svg class="nav-icon" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25z"/></svg><span data-i18n="app">Application</span></a>
<a href="member.html" class="nav-item"><svg class="nav-icon" viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg><span data-i18n="members">Members</span></a>
<a href="help.html" class="nav-item"><svg class="nav-icon" viewBox="0 0 24 24"><path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56-.35-.12-.74-.03-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.39-1.11-.59-2.28-.59-3.53 0-.55-.45-1-1-1H4c-.55 0-1-1.45-1 0 9.39 7.61 17 17 17.55 0 1-.45 1-1v-3.49c0-.55-.45-1-1-1z"/></svg><span data-i18n="help">Helpline</span></a>
<a href="laws.html" class="nav-item"><svg class="nav-icon" viewBox="0 0 24 24"><path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2-1.9-2-2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-1 9H9V9h10v2zm-4 4H9v-2h6v2zm4-8H9V5h10v2z"/></svg><span data-i18n="laws">Laws</span></a>
</nav><script>
const TRANSLATIONS={
en:{logout:"Logout",notif_title:"Notifications",notif_sub:"All updates from Lodge Director",loading:"Loading notifications...",empty_title:"No notifications yet",empty_sub:"Director announcements will appear here",copy:"Copy",delete:"Delete",copied:"Notification copied",deleted:"Notification deleted successfully",new_badge:"New",home:"Home",req:"Requirements",app:"Application",members:"Members",help:"Helpline",laws:"Laws"},
sw:{logout:"Toka",notif_title:"Arifa",notif_sub:"Sasisho zote kutoka kwa Mkurugenzi",loading:"Inapakia arifa...",empty_title:"Hakuna arifa bado",empty_sub:"Matangazo ya Mkurugenzi yataonekana hapa",copy:"Nakili",delete:"Futa",copied:"Arifa imenakiliwa",deleted:"Arifa imefutwa kwa mafanikio",new_badge:"Mpya",home:"Nyumbani",req:"Mahitaji",app:"Maombi",members:"Wanachama",help:"Msaada",laws:"Sheria"},
lg:{logout:"Fuluma",notif_title:"Okutegeeza",notif_sub:"Zonna okuva eri Director",loading:"Kiteekateeka...",empty_title:"Tewali kutegeeza",empty_sub:"Zinaalabikira wano",copy:"Koppa",delete:"Sangula",copied:"Okutegeeza kukopiddwa",deleted:"Okutegeeza kusanguddwa bulungi",new_badge:"Mpya",home:"Awaka",req:"Ebyetaago",app:"Okusaba",members:"Bammemba",help:"Obuyambi",laws:"Amateeka"},
rw:{logout:"Sohoka",notif_title:"Amakuru",notif_sub:"Ibyavuguruwe na Director",loading:"Irakura...",empty_title:"Nta makuru",empty_sub:"Bizagaragara hano",copy:"Koporora",delete:"Siba",copied:"Itangazo ryakoporowe",deleted:"Itangazo ryasibwe neza",new_badge:"Gishya",home:"Ahabanza",req:"Ibisabwa",app:"Gusaba",members:"Abanyamuryango",help:"Ubufasha",laws:"Amategeko"},
pt:{logout:"Sair",notif_title:"Notificações",notif_sub:"Todas atualizações do Diretor",loading:"Carregando...",empty_title:"Nenhuma notificação",empty_sub:"Anúncios aparecerão aqui",copy:"Copiar",delete:"Deletar",copied:"Notificação copiada",deleted:"Notificação deletada com sucesso",new_badge:"Novo",home:"Início",req:"Requisitos",app:"Aplicação",members:"Membros",help:"Ajuda",laws:"Leis"},
fr:{logout:"Déconnexion",notif_title:"Notifications",notif_sub:"Toutes les mises à jour du Directeur",loading:"Chargement...",empty_title:"Pas de notifications",empty_sub:"Les annonces apparaîtront ici",copy:"Copier",delete:"Supprimer",copied:"Notification copiée",deleted:"Notification supprimée avec succès",new_badge:"Nouveau",home:"Accueil",req:"Exigences",app:"Application",members:"Membres",help:"Aide",laws:"Lois"},
zu:{logout:"Phuma",notif_title:"Izaziso",notif_sub:"Zonke izibuyekezo zika Director",loading:"Iyalayisha...",empty_title:"Azikho izaziso",empty_sub:"Zizovela lapha",copy:"Kopisha",delete:"Susa",copied:"Isaziso sikhopishiwe",deleted:"Isaziso sisuswe ngempumelelo",new_badge:"Okusha",home:"Ekhaya",req:"Okudingekayo",app:"Isicelo",members:"Amalungu",help:"Usizo",laws:"Imithetho"},
ha:{logout:"Fita",notif_title:"Sanarwa",notif_sub:"Duk sabuntawa daga Director",loading:"Ana lodawa...",empty_title:"Babu sanarwa",empty_sub:"Za su bayyana anan",copy:"Kwafi",delete:"Share",copied:"An kwafi sanarwa",deleted:"An share sanarwa cikin nasara",new_badge:"Sabo",home:"Gida",req:"Abubuwan",app:"Aikace",members:"Membobi",help:"Taimako",laws:"Dokoki"},
tw:{logout:"Fi mu",notif_title:"Nsɛm",notif_sub:"Director nsɛm nyinaa",loading:"Ɛreloada...",empty_title:"Nsɛm biara nni hɔ",empty_sub:"Ɛbɛba ha",copy:"Kɔpi",delete:"Pepa",copied:"Nsɛm no akɔpi",deleted:"Nsɛm no apepa yiye",new_badge:"Foforo",home:"Fi",req:"Ahwehwɛde",app:"Abisade",members:"Agbatɔfo",help:"Mmoa",laws:"Mmara"},
am:{logout:"ውጣ",notif_title:"ማሳወቂያዎች",notif_sub:"ከዳይሬክተር የተሰጡ ዝመናዎች",loading:"በመጫን ላይ...",empty_title:"ምንም ማሳወቂያ የለም",empty_sub:"እዚህ ይታያል",copy:"ቅዳ",delete:"ሰርዝ",copied:"ማሳወቂያ ተቀድቷል",deleted:"ማሳወቂያ በተሳካ ሁኔታ ተሰርዟል",new_badge:"አዲስ",home:"መነሻ",req:"መስፈርቶች",app:"ማመልከቻ",members:"አባላት",help:"እገዛ",laws:"ሕጎች"},
sn:{logout:"Buda",notif_title:"Ziziviso",notif_sub:"Zvese kubva kuna Director",loading:"Kurodha...",empty_title:"Hakuna ziziviso",empty_sub:"Zichaonekwa pano",copy:"Kopa",delete:"Dzima",copied:"Chiziviso chakopwa",deleted:"Chiziviso chadzimwa zvakanaka",new_badge:"Itsva",home:"Kumba",req:"Zvinodiwa",app:"Chikumbiro",members:"Nhengo",help:"Rubatsiro",laws:"Mitemo"},
bem:{logout:"Fuma",notif_title:"Insoselo",notif_sub:"Fyonse ukufuma ku Director",loading:"Ukupakisha...",empty_title:"Takuli insoselo",empty_sub:"Fikaloleshwa pano",copy:"Kopola",delete:"Futa",copied:"Insoselo nakopwa",deleted:"Insoselo nafutiwa bwino",new_badge:"Ipye",home:"Ku Ng'anda",req:"Ifikabilwa",app:"Ukupempula",members:"Ba Member",help:"Ubwafwilisho",laws:"Amalango"},
tn:{logout:"Tswa",notif_title:"Dikitsiso",notif_sub:"Tsotlhe go tswa go Director",loading:"Go laolwa...",empty_title:"Ga go na dikitsiso",empty_sub:"Di tla bonala fa",copy:"Kopola",delete:"Phimola",copied:"Kitsiso e kopolotse",deleted:"Kitsiso e phimotswe ka katlego",new_badge:"Ntsha",home:"Gae",req:"Dikgato",app:"Kopo",members:"Maloko",help:"Thuso",laws:"Melao"},
ng:{logout:"Zapo",notif_title:"Omakwatathano",notif_sub:"Ayihe gokwa Director",loading:"Otayi longwa...",empty_title:"Kape na omakwatathano",empty_sub:"Otaga monika mpano",copy:"Kopa",delete:"Dhana po",copied:"Omakwatathano ga kopa",deleted:"Omakwatathano ga dhana po nawa",new_badge:"Ipe",home:"Pehaya",req:"Oshinakugwanithwa",app:"Epulo",members:"Oohambe",help:"Ekwatho",laws:"Ompango"},
hi:{logout:"लॉगआउट",notif_title:"सूचनाएं",notif_sub:"निदेशक से सभी अपडेट",loading:"लोड हो रहा है...",empty_title:"कोई सूचना नहीं",empty_sub:"घोषणाएं यहां दिखेंगी",copy:"कॉपी",delete:"हटाएं",copied:"सूचना कॉपी की गई",deleted:"सूचना सफलतापूर्वक हटाई गई",new_badge:"नया",home:"होम",req:"आवश्यकताएँ",app:"आवेदन",members:"सदस्य",help:"सहायता",laws:"कानून"}
};
function getLang(){return localStorage.getItem('siteLang')||'en';}
function applyLang(){
 const lang=getLang(); const dict=TRANSLATIONS[lang]||TRANSLATIONS.en;
 document.querySelectorAll('[data-i18n]').forEach(el=>{
  const k=el.dataset.i18n;
  if(dict[k]) el.textContent=dict[k];
 });
}
applyLang(); setInterval(applyLang,500);
function showToast(msg){
 const t=document.getElementById("toast"); t.textContent=msg; t.classList.add("show");
 setTimeout(()=>t.classList.remove("show"),2500);
}
</script><script src="notification-system.js"></script>
<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
import { getAuth, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";
import { getDatabase, ref, onValue, remove } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-database.js";

// For Firebase JS SDK v7.20.0 and later, measurementId is optional
const firebaseConfig = {
  apiKey: "AIzaSyBSs3ekiR8vQ_1Ar5oZVBKGjuOQbwcgNEM",
  authDomain: "mansonry-family-fraternity.firebaseapp.com",
  databaseURL: "https://mansonry-family-fraternity-default-rtdb.europe-west1.firebasedatabase.app",
  projectId: "mansonry-family-fraternity",
  storageBucket: "mansonry-family-fraternity.firebasestorage.app",
  messagingSenderId: "964415179161",
  appId: "1:964415179161:web:cef44a38e4de304d7c6b08",
  measurementId: "G-9Q2KEWMXVR"
};

const app=initializeApp(firebaseConfig);const auth=getAuth(app);const db=getDatabase(app);

function setBadge(id,count){const el=document.getElementById(id);if(!el)return;if(count>0){el.textContent=count>99?"99+":count;el.style.display="grid";localStorage.setItem(id+"_count",count);}else{el.style.display="none";localStorage.removeItem(id+"_count");}}
function updateAppIcon(){const c1=parseInt(document.getElementById("globalChatBadge")?.textContent||"0");const c2=parseInt(document.getElementById("notifBadge")?.textContent||"0");const total=(isNaN(c1)?0:c1)+(isNaN(c2)?0:c2);if(window.LodgeNotifier)window.LodgeNotifier.setAppIconBadge(total);}onAuthStateChanged(auth,(user)=>{
if(!user){location.href="login.html";return;}
const uid=user.uid;

// 1. NOTIFICATIONS = ONLY DIRECTOR ANNOUNCEMENTS - REAL-TIME onValue
onValue(ref(db,`notifications/${uid}`),(snap)=>{
const list=document.getElementById("notifList");
const lang=getLang(); const dict=TRANSLATIONS[lang]||TRANSLATIONS.en;
if(!snap.exists()){
list.innerHTML=`<div id="empty"><i class="fa fa-bullhorn" style="font-size:40px;color:var(--gold);"></i><br><br><span>${dict.empty_title}</span><br><small>${dict.empty_sub}</small></div>`;
setBadge("notifBadge",0);updateAppIcon();return;
}
let items=[];
snap.forEach(c=>{const v=c.val();v._key=c.key;items.push(v);});
items = items.filter(n => n.type==="announcement" || n.isBroadcast===true || n.category==="director_announcement" ||!n.senderId);
items.sort((a,b)=>(b.createdAt||0)-(a.createdAt||0));
if(items.length===0){
list.innerHTML=`<div id="empty"><i class="fa fa-bell-slash" style="font-size:40px;color:var(--gold);"></i><br><br><span>${dict.empty_title}</span><br><small>${dict.empty_sub}</small></div>`;
setBadge("notifBadge",0);updateAppIcon();return;
}
let html="";let unread=0;
items.forEach(n=>{
if(!n.read)unread++;
const time=new Date(n.createdAt||Date.now()).toLocaleString();
html+=`<div class="notif-card ${!n.read?'unread':''}" id="card-${n._key}">
<div class="notif-icon"><i class="fa fa-bullhorn"></i></div>
<div class="notif-content">
<b>${n.title||"Lodge Announcement"}</b>
<p id="msg-${n._key}">${n.message||""}</p>
<div class="notif-time">${time} ${!n.read?'<span style="color:#00ff88;">● '+dict.new_badge+'</span>':''}</div>
<div class="notif-actions">
<button class="action-btn" onclick="copyNotif('${n._key}')"><i class="fa fa-copy"></i> ${dict.copy}</button>
<button class="action-btn delete" onclick="deleteNotif('${n._key}')"><i class="fa fa-trash"></i> ${dict.delete}</button>
</div>
</div>
</div>`;
});
list.innerHTML=html;
setBadge("notifBadge",unread);updateAppIcon();
});

// 2. INBOX = ONLY CHAT MESSAGES member ↔ admin - REAL-TIME onValue
onValue(ref(db,`chats`),(snap)=>{
let total=0;
if(snap.exists()){
snap.forEach(cs=>{
const chatId=cs.key;
if(!chatId.includes(uid))return;
const chat=cs.val();
const lastSeen=chat.seenByMember||0;
const msgs=chat.messages||{};
Object.values(msgs).forEach(m=>{
if(m.type==="announcement")return;
if(m.senderId!==uid && (m.time||0)>lastSeen) total++;
});
});
}
setBadge("globalChatBadge",total);updateAppIcon();
});

window.copyNotif=(key)=>{
const txt=document.getElementById("msg-"+key)?.innerText||"";
navigator.clipboard.writeText(txt).then(()=>{
const lang=getLang(); showToast((TRANSLATIONS[lang]||TRANSLATIONS.en).copied);
});
};
window.deleteNotif=async(key)=>{
const lang=getLang(); const dict=TRANSLATIONS[lang]||TRANSLATIONS.en;
await remove(ref(db,`notifications/${uid}/${key}`));
showToast(dict.deleted);
document.getElementById("card-"+key)?.remove();
};

});
document.getElementById("logoutBtn").addEventListener("click",(e)=>{e.preventDefault();signOut(auth).then(()=>location.href="login.html");});
</script>
</body>
</html>
